{
  "name": "auto-m8",
  "productName": "auto-m8",
  "version": "0.1.0",
  "private": true,
  "description": "An always-on home for your agent conversations, PRs and terminals, on macOS",
  "type": "module",
  "main": "shell/main.cjs",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "build": "vite build",
    "serve": "node server/main.ts",
    "demo": "node scripts/demo-seed.mjs --serve",
    "dev": "node --watch server/main.ts & vite",
    "start": "npm run build && npm run app",
    "app": "open -n -a \"$PWD/node_modules/electron/dist/Electron.app\" --args \"$PWD\"",
    "dist": "vite build && node scripts/fetch-node.mjs && electron-builder --mac --publish never",
    "dist:arm64": "vite build && node scripts/fetch-node.mjs arm64 && electron-builder --mac dmg zip --arm64 --publish never",
    "test": "PERCH_OWNER_NAME=Ana PERCH_DB=:memory: PERCH_DATA=$(mktemp -d) node --test server/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "allowScripts": {
    "node-pty": true,
    "electron": true
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.11",
    "harper.js": "^3.2.0",
    "marked": "^18.1.3",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rrweb": "2.0.0-alpha.4",
    "rrweb-player": "1.0.0-alpha.4",
    "simple-icons": "^15.22.0",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "author": "Daniel Visca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielVisca/auto-m8.git"
  },
  "homepage": "https://github.com/DanielVisca/auto-m8",
  "bugs": {
    "url": "https://github.com/DanielVisca/auto-m8/issues"
  },
  "keywords": [
    "claude-code",
    "agents",
    "electron",
    "macos",
    "pull-requests",
    "ai"
  ]
}
